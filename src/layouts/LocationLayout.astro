---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  city: string;
  state: string;
  pubDate: string;
}

const { title, description, city, state, pubDate } = Astro.props;

const formattedPubDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} type="website">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://homeservice-usa.com/" },
        { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://homeservice-usa.com/locations/" },
        { "@type": "ListItem", "position": 3, "name": `${city}, ${state}`, "item": Astro.url.href }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": Astro.url.href
    })} />
  </Fragment>

  <article class="location-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/locations/">Locations</a> <span>/</span> <span>{city}, {state}</span>
      </nav>
      <div class="location-header">
        <h1>{title}</h1>
        <p class="location-description">{description}</p>
        <p class="location-updated">Last updated {formattedPubDate}</p>
      </div>
      <div class="location-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .location-page { padding: 2rem 0 3rem; }
  .breadcrumbs { max-width: var(--content-width); margin: 0 auto 1.5rem; font-size: 0.85rem; color: var(--color-text-light); }
  .breadcrumbs a { color: var(--color-text-light); }
  .breadcrumbs a:hover { color: var(--color-primary); }
  .breadcrumbs span { margin: 0 0.4rem; }
  .location-header { max-width: var(--content-width); margin: 0 auto 2rem; }
  .location-header h1 { font-size: 2.25rem; line-height: 1.2; margin-bottom: 1rem; }
  .location-description { font-size: 1.15rem; color: var(--color-text-light); line-height: 1.6; margin: 0; }
  .location-updated { font-size: 0.85rem; color: var(--color-text-light); margin-top: 1rem; }
  .location-content { max-width: var(--content-width); margin: 0 auto; }
  .location-content :global(h2) { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .location-content :global(h2:first-of-type) { border-top: none; padding-top: 0; }
  @media (max-width: 768px) {
    .location-header h1 { font-size: 1.75rem; }
    .location-description { font-size: 1.05rem; }
  }
</style>
