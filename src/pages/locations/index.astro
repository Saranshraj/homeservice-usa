---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cities = await getCollection('locations');
const sortedCities = cities.sort((a, b) => a.data.city.localeCompare(b.data.city));
---

<BaseLayout
  title="Home Service Guides by City"
  description="City-specific home repair and service guides for HVAC, plumbing, roofing, and more. Local costs, climate risks, and licensing information for major US metros."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://homeservice-usa.com/" },
        { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://homeservice-usa.com/locations/" }
      ]
    })} />
  </Fragment>

  <section class="locations-hero">
    <div class="container">
      <h1>Home Service Guides by City</h1>
      <p class="hero-subtitle">Local costs, climate risks, and service guidance vary a lot depending on where you live. These city guides pair our national cost data with what actually matters in your market: local weather patterns, licensing rules, and seasonal timing.</p>
    </div>
  </section>

  <section class="cities-section">
    <div class="container">
      <div class="cities-grid">
        {sortedCities.map(city => (
          <a href={`/locations/${city.data.citySlug}/`} class="city-card">
            <h2>{city.data.city}, {city.data.stateAbbr}</h2>
            <p>{city.data.description}</p>
            <span class="card-link">View city guide</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .locations-hero {
    background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #2563eb 100%);
    color: white;
    padding: 3rem 0;
  }
  .locations-hero h1 { color: white; font-size: 2.25rem; margin-bottom: 1rem; }
  .hero-subtitle { color: #bfdbfe; font-size: 1.1rem; line-height: 1.6; max-width: 700px; margin: 0; }
  .cities-section { padding: 3rem 0; }
  .cities-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .city-card {
    display: block;
    padding: 1.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: box-shadow 0.2s, transform 0.2s;
    color: var(--color-text);
  }
  .city-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); color: var(--color-text); }
  .city-card h2 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  .city-card p { font-size: 0.9rem; color: var(--color-text-light); margin: 0 0 1rem; line-height: 1.5; }
  .card-link { font-size: 0.85rem; color: var(--color-primary); font-weight: 600; }
  @media (max-width: 768px) {
    .cities-grid { grid-template-columns: 1fr; }
    .locations-hero h1 { font-size: 1.75rem; }
  }
</style>
